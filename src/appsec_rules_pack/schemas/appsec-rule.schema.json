{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lucashgrifoni/AppSec-Rules-Pack/v0.5.0/src/appsec_rules_pack/schemas/appsec-rule.schema.json",
  "$comment": "Canonical versioned $id pinned to the release tag. When the schema changes in a way that affects consumers, publish it under a new tag and update this $id to that tag. Packs may declare the schema version they target in pack.schema_version; see VERSIONING.md.",
  "title": "AppSec Rules Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "rules"],
  "properties": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "mode", "owner", "description"],
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mode": {
          "type": "string",
          "enum": ["advisory", "audit", "blocking"]
        },
        "owner": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "snippet", "explanation"],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "python",
            "javascript",
            "typescript",
            "go",
            "java",
            "csharp",
            "ruby",
            "php",
            "bash",
            "yaml",
            "json",
            "toml",
            "hcl",
            "sql",
            "text"
          ]
        },
        "snippet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 480
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compliant", "violating"],
      "properties": {
        "compliant": {
          "$ref": "#/$defs/example"
        },
        "violating": {
          "$ref": "#/$defs/example"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "severity",
        "category",
        "status",
        "enforcement",
        "targets",
        "mappings",
        "evidence",
        "match",
        "remediation",
        "exceptions"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 360
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "category": {
          "type": "string",
          "enum": [
            "authentication",
            "authorization",
            "input-validation",
            "injection",
            "ssrf",
            "secrets",
            "file-handling",
            "logging",
            "dependency-risk",
            "configuration",
            "csrf",
            "integrity",
            "data-exposure",
            "open-redirect",
            "rate-limiting"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["enabled", "disabled", "draft", "deprecated"]
        },
        "enforcement": {
          "type": "string",
          "enum": ["advisory", "audit", "blocking"]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["api", "backend", "frontend", "mobile", "ci", "iac", "data", "dependencies", "general"]
          }
        },
        "mappings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owasp_asvs", "cwe", "nist_ssdf"],
          "patternProperties": {
            "^x-": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          },
          "properties": {
            "owasp_asvs": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "owasp_api_top_10_2023": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "owasp_top_10_2025": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "cwe": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "nist_ssdf": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "signals"],
          "properties": {
            "required": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "signals": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "includes", "excludes"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["review", "static-analysis", "configuration", "schema"]
            },
            "includes": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "excludes": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guidance", "validation"],
          "properties": {
            "guidance": {
              "type": "string",
              "minLength": 20,
              "maxLength": 480
            },
            "validation": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "max_days", "required_fields"],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "max_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            "required_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["owner", "justification", "expires_at", "compensating_control", "validation_plan"]
              }
            }
          }
        },
        "examples": {
          "$ref": "#/$defs/examples"
        },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 10,
              "maxLength": 240
            },
            "replaced_by": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+-[0-9]{3}$"
            },
            "since": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    }
  }
}
