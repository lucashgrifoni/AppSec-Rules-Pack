{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lucashgrifoni/AppSec-Rules-Pack/v0.7.0/src/appsec_rules_pack/schemas/review-record.schema.json",
  "$comment": "Input of `appsec-rules review`: the outcome of reviewing one subject (a service, repository, or release) against one rules pack. See ADR-0006 and VERSIONING.md.",
  "title": "AppSec Rules Pack review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["review", "results"],
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "subject", "reviewer", "date"],
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "pack": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "pack.id of the rules pack the subject was reviewed against."
        },
        "pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "pack.version at review time. A mismatch is reported as a warning."
        },
        "subject": {"$ref": "#/$defs/text"},
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Exact revision reviewed: a commit SHA, tag, image digest, or package version."
        },
        "reviewer": {"$ref": "#/$defs/text"},
        "date": {"$ref": "#/$defs/date"},
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        }
      }
    },
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "status"],
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+-[0-9]{3}$"
        },
        "status": {
          "enum": ["met", "not-met", "not-applicable", "excepted"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"}
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        "exception": {"$ref": "#/$defs/exception"}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at"],
      "properties": {
        "owner": {"$ref": "#/$defs/text"},
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        "granted_at": {"$ref": "#/$defs/date"},
        "expires_at": {"$ref": "#/$defs/date"},
        "compensating_control": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        "validation_plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        }
      }
    }
  }
}
